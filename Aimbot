local function EnableNoclip()
    local character = GetCharacter()
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if OriginalCollisions[part] == nil then
                OriginalCollisions[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end

local function DisableNoclip()
    for part, originalValue in pairs(OriginalCollisions) do
        if part and part.Parent then
            part.CanCollide = originalValue
        end
    end
    table.clear(OriginalCollisions)
end

local function StopFly()
    FlyEnabled = false

    if FlyVelocity then
        FlyVelocity:Destroy()
        FlyVelocity = nil
    end

    if FlyGyro then
        FlyGyro:Destroy()
        FlyGyro = nil
    end

    local character = GetCharacter()
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.PlatformStand = false
        humanoid.AutoRotate = true
    end

    UpdateFlyButton()
end

local function StartFly()
    local character = GetCharacter()
    if not character then
        StopFly()
        return
    end

    local root = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")

    if not root or not humanoid or humanoid.Health <= 0 then
        StopFly()
        return
    end

    StopFly()
    FlyEnabled = true

    humanoid.PlatformStand = true
    humanoid.AutoRotate = false

    local velocity = Instance.new("BodyVelocity")
    velocity.Name = "GameFlyVelocity"
    velocity.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    velocity.P = 10000
    velocity.Velocity = Vector3.zero
    velocity.Parent = root
    FlyVelocity = velocity

    local gyro = Instance.new("BodyGyro")
    gyro.Name = "GameFlyGyro"
    gyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    gyro.P = 10000
    gyro.D = 500
    gyro.CFrame = Camera.CFrame
    gyro.Parent = root
    FlyGyro = gyro

    UpdateFlyButton()
end

local function UpdateFly()
    if not FlyEnabled then return end

    local character = GetCharacter()
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not character
        or not root
        or not humanoid
        or humanoid.Health <= 0
        or not FlyVelocity
        or not FlyGyro
        or FlyVelocity.Parent ~= root
        or FlyGyro.Parent ~= root then
        StopFly()
        return
    end

    local cameraCF = Camera.CFrame
    local forward = 0
    local sideways = 0
    local vertical = 0

    if UserInputService:IsKeyDown(Enum.KeyCode.W) then forward += 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then forward -= 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then sideways += 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then sideways -= 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical += 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
        vertical -= 1
    end

    local direction =
        cameraCF.LookVector * forward
        + cameraCF.RightVector * sideways
        + Vector3.new(0, vertical, 0)

    if direction.Magnitude > 0 then
        direction = direction.Unit
    end

    FlyVelocity.Velocity = direction * FlySpeed
    FlyGyro.CFrame = cameraCF
end

