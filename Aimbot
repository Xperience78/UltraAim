local DraggingSlider = false

local function UpdateSlider(x)
    local relative = math.clamp(
        (x - SliderBG.AbsolutePosition.X) / SliderBG.AbsoluteSize.X,
        0,
        1
    )

    FlySpeed = math.clamp(
        math.round(1 + relative * 499),
        1,
        500
    )

    local percentage = (FlySpeed - 1) / 499
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)

    if not SpeedValueBox:IsFocused() then
        SpeedValueBox.Text = tostring(FlySpeed)
    end
end

SpeedValueBox.FocusLost:Connect(function()
    local value = tonumber(SpeedValueBox.Text)

    if not value then
        SpeedValueBox.Text = tostring(FlySpeed)
        return
    end

    FlySpeed = math.clamp(math.floor(value), 1, 500)

    local percentage = (FlySpeed - 1) / 499
    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
    SpeedValueBox.Text = tostring(FlySpeed)
end)

local function BeginSlider(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = true
        UpdateSlider(input.Position.X)
    end
end

SliderBG.InputBegan:Connect(BeginSlider)
SliderKnob.InputBegan:Connect(BeginSlider)

local DraggingMenu = false
local DragStartPos = Vector2.zero
local MenuStartPos = DefaultMenuPos

MainFrame.InputBegan:Connect(function(input)
    if DraggingSlider or DraggingDistSlider then return end

    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        DraggingMenu = true
        DragStartPos = input.Position
        MenuStartPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        if DraggingDistSlider then
            UpdateDistSlider(input.Position.X)
        elseif DraggingSlider then
            UpdateSlider(input.Position.X)
        elseif DraggingMenu then
            local delta = input.Position - DragStartPos
            MainFrame.Position = UDim2.new(
                MenuStartPos.X.Scale,
                MenuStartPos.X.Offset + delta.X,
                MenuStartPos.Y.Scale,
                MenuStartPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        DraggingSlider = false
        DraggingDistSlider = false
        DraggingMenu = false
    end
end)

local LoaderFinished = false

UserInputService.InputBegan:Connect(function(input, gp)
    if gp or not LoaderFinished then return end

    if input.KeyCode == Enum.KeyCode.RightShift then
        if not MainFrame.Visible then
            MainFrame.Position = DefaultMenuPos
            MainFrame.Visible = true
        else
            MainFrame.Visible = false
        end
    end
end)

LocalPlayer.CharacterRemoving:Connect(function()
    StopFly()

    if NoclipEnabled then
        DisableNoclip()
    end

    table.clear(OriginalCollisions)
end)

LocalPlayer.CharacterAdded:Connect(function(character)
    StopFly()
    table.clear(OriginalCollisions)

    if NoclipEnabled then
        task.wait(0.5)
        EnableNoclip()
    end

    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        humanoid.Died:Connect(function()
            StopFly()
        end)
    end

    UpdateFlyButton()
end)

RunService.RenderStepped:Connect(function(dt)
    Camera = Workspace.CurrentCamera or Camera

    RefreshRayFilter()
    StepAim(dt)
    UpdateESP()

    if NoclipEnabled then
        EnableNoclip()
    end

    if FlyEnabled then
        UpdateFly()
    end
end)

RunService.Heartbeat:Connect(function(dt)
    UpdateTracker(dt)
end)

Players.PlayerRemoving:Connect(function(plr)
    Track[plr] = nil

    if ESPHighlights[plr] then
        ESPHighlights[plr]:Destroy()
        ESPHighlights[plr] = nil
