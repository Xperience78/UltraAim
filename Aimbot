local function IsEnemy(plr)
    if not Settings.TeamCheck then return true end

    local a, b = LocalPlayer:GetAttribute("Team"), plr:GetAttribute("Team")
    if a ~= nil and b ~= nil then
        return a ~= b
    end

    if LocalPlayer.Team and plr.Team then
        return LocalPlayer.Team ~= plr.Team
    end

    return true
end

local function GetAlive(plr)
    local ch = plr.Character
    if not ch then return nil end

    local hum = ch:FindFirstChildOfClass("Humanoid")
    if hum and hum.Health <= 0 then
        return nil
    end

    if not ch:FindFirstChild("HumanoidRootPart") and not ch:FindFirstChild("Head") then
        return nil
    end

    return ch, hum
end

local function IsVisible(part, ch)
    local origin = Camera.CFrame.Position
    local res = Workspace:Raycast(origin, part.Position - origin, rayParams)
    if not res then return true end
    return res.Instance:IsDescendantOf(ch)
end

local function ScreenCenter()
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X / 2, vp.Y / 2)
end

local Track = {}
local pingCache = 0.05
local pingTimer = 0

local function UpdateTracker(dt)
    if dt <= 0 then return end

    pingTimer += dt
    if pingTimer >= 1 then
        pingTimer = 0
        local ok, v = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(v) == "number" then
            pingCache = math.clamp(v / 1000, 0.01, 0.5)
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = plr.Character
            local root = ch and ch:FindFirstChild("HumanoidRootPart")

            if root then
                local tr = Track[plr]
                if tr and tr.Char == ch then
                    local raw = (root.Position - tr.Pos) / dt
                    if raw.Magnitude > 120 then
                        tr.Vel = Vector3.zero
                    else
                        tr.Vel = tr.Vel:Lerp(raw, 0.35)
                    end
                    tr.Pos = root.Position
                else
                    Track[plr] = {
                        Char = ch,
                        Pos = root.Position,
                        Vel = Vector3.zero
                    }
                end
            else
                Track[plr] = nil
            end
        end
    end
end

local function Predict(plr, part)
    local pos = part.Position
    if not Settings.Predict then return pos end

    local tr = Track[plr]
    local vel = tr and tr.Vel or part.AssemblyLinearVelocity
    local lead = Settings.LeadMs / 1000

    if Settings.AutoPing then
        lead += pingCache * 0.5 + 0.015
    end

    return pos + Vector3.new(vel.X, vel.Y * 0.4, vel.Z) * lead
end

local CurrentTarget
local LockedPlr

local function PickPart(ch, wall)
    local sel = Settings.AimPart
    local head = ch:FindFirstChild("Head")
    local torso =
        ch:FindFirstChild("UpperTorso")
        or ch:FindFirstChild("Torso")
        or ch:FindFirstChild("HumanoidRootPart")

    if sel == "Head" then return head or torso end
    if sel == "Torso" then return torso or head end

    if head and (not wall or IsVisible(head, ch)) then
        return head
    end

    return torso
end

local function Evaluate(plr, center, camPos, fov)
    if plr == LocalPlayer or not IsEnemy(plr) then
        return nil
    end

    local ch, hum = GetAlive(plr)
    if not ch then return nil end

    local wall = Settings.WallCheck
    local part = PickPart(ch, wall)
    if not part then return nil end

    local dist = (part.Position - camPos).Magnitude
    if dist > Settings.MaxDist then
        return nil
    end

    local sp = Camera:WorldToViewportPoint(part.Position)
    if sp.Z <= 0 then return nil end

    local screenDist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
    if screenDist > fov then return nil end

    if wall and not IsVisible(part, ch) then
        return nil
    end

    return {
        Plr = plr,
        Part = part,
        Score = screenDist,
        Dist = dist,
        HP = hum and hum.Health or 100
    }
end

local function GetTarget()
    local center = ScreenCenter()
    local camPos = Camera.CFrame.Position
    local fov = Settings.FOV

    if Settings.Sticky and LockedPlr and LockedPlr.Parent == Players then
        local rec = Evaluate(LockedPlr, center, camPos, fov * 1.5)
        if rec then return rec end
        LockedPlr = nil
    end

    local best
    for _, plr in ipairs(Players:GetPlayers()) do
        local rec = Evaluate(plr, center, camPos, fov)
        if rec and (not best or rec.Score < best.Score) then
            best = rec
        end
    end

    return best
end

local function IsAimActive()
    if typeof(Settings.Keybind) == "EnumItem" then
        if Settings.Keybind.EnumType == Enum.UserInputType then
            return UserInputService:IsMouseButtonPressed(Settings.Keybind)
        elseif Settings.Keybind.EnumType == Enum.KeyCode then
            return UserInputService:IsKeyDown(Settings.Keybind)
        end
    end
    return true
end

local aimAccum = Vector2.zero
local lastTargetPlr
local acquiredAt = 0

local function AimAt(worldPos, dt)
    local sp = Camera:WorldToViewportPoint(worldPos)
    if sp.Z <= 0 then return end

    local delta = Vector2.new(sp.X, sp.Y) - ScreenCenter()

    if Settings.Humanize then
        local t, h = os.clock(), Settings.HumanizeAmt
        delta += Vector2.new(
            math.noise(t * 2.3, 11) * h,
            math.noise(t * 2.1, 37) * h
        )
    end

    if delta.Magnitude < 1.2 then return end

    local base = math.clamp(1 - Settings.Smoothing, 0.03, 1)
    local alpha = 1 - (1 - base) ^ (math.clamp(dt, 0, 0.1) * 60)
    local move = delta * alpha

    if move.Magnitude > Settings.MaxStep then
        move = move.Unit * Settings.MaxStep
    end

    if Settings.UseMouse and mousemoverel then
        aimAccum += move * Settings.MouseGain
        local ix, iy = math.round(aimAccum.X), math.round(aimAccum.Y)
        if ix ~= 0 or iy ~= 0 then
            aimAccum -= Vector2.new(ix, iy)
            pcall(mousemoverel, ix, iy)
        end
    else
        local goal = CFrame.new(Camera.CFrame.Position, worldPos)
        Camera.CFrame = Camera.CFrame:Lerp(goal, alpha)
    end
end

local function StepAim(dt)
    FOVCircle.Visible = Settings.Enabled and Settings.ShowFOV

    if FOVCircle.Visible then
        FOVCircle.Size = UDim2.fromOffset(Settings.FOV * 2, Settings.FOV * 2)
    end

    if not Settings.Enabled
        or UserInputService:GetFocusedTextBox()
        or not IsAimActive() then
        CurrentTarget, LockedPlr, lastTargetPlr = nil, nil, nil
        aimAccum = Vector2.zero
        return
    end

    local rec = GetTarget()
    CurrentTarget = rec

    if not rec then
        LockedPlr, lastTargetPlr = nil, nil
        return
    end

    if Settings.Sticky then
        LockedPlr = rec.Plr
    end

    if rec.Plr ~= lastTargetPlr then
        lastTargetPlr = rec.Plr
        acquiredAt = os.clock()
    end

    if os.clock() - acquiredAt < Settings.ReactionMs / 1000 then
        return
    end

    AimAt(Predict(rec.Plr, rec.Part), dt)
end

local ESPHighlights = {}

local function UpdateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local ch = plr.Character

            if Settings.ESPEnabled and ch then
                local hl = ESPHighlights[plr]

                if not hl or hl.Parent ~= ch then
                    if hl then hl:Destroy() end

                    hl = Instance.new("Highlight")
                    hl.Name = "WhiteESP"
                    hl.Adornee = ch
                    hl.FillColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent = ch

                    ESPHighlights[plr] = hl
                end
            else
                if ESPHighlights[plr] then
                    ESPHighlights[plr]:Destroy()
                    ESPHighlights[plr] = nil
                end
            end
        end
    end
end

