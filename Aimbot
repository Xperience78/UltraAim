local function SyncDistUI()
    local percentage = (Settings.MaxDist - MinDist) / (MaxDistLimit - MinDist)
    DistSliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    DistSliderKnob.Position = UDim2.new(percentage, 0, 0.5, 0)
    if not DistValueBox:IsFocused() then
        DistValueBox.Text = tostring(Settings.MaxDist)
    end
end

local function UpdateDistSlider(x)
    local relative = math.clamp(
        (x - DistSliderBG.AbsolutePosition.X) / DistSliderBG.AbsoluteSize.X,
        0,
        1
    )

    Settings.MaxDist = math.clamp(
        math.round(MinDist + relative * (MaxDistLimit - MinDist)),
        MinDist,
        MaxDistLimit
    )

    SyncDistUI()
end

DistValueBox.FocusLost:Connect(function()
    local value = tonumber(DistValueBox.Text)

    if not value then
        DistValueBox.Text = tostring(Settings.MaxDist)
        return
    end

    Settings.MaxDist = math.clamp(math.floor(value), MinDist, MaxDistLimit)
    SyncDistUI()
end)

local function BeginDistSlider(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        DraggingDistSlider = true
        UpdateDistSlider(input.Position.X)
    end
end

